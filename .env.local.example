## Single source of truth for the Docker-backed local environment
## Frontend (Vite)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
VITE_CRM_BACKEND_URL=http://localhost:3000
VITE_ENABLE_DASHBOARD_RPC=true
VITE_AGENT_TOOLS_UI_ENABLED=true

## Backend IA (Project/IA reads this root file automatically)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

GEMINI_API_KEY=<your-gemini-key>
CRM_ANALYSIS_WORKER_MODEL=gemini-3.1-flash-lite
PIPELINE_WORKER_ENABLED=false
PIPELINE_WORKER_POLL_MS=60000
PIPELINE_WORKER_BATCH_SIZE=10
PIPELINE_WORKER_LEASE_SECONDS=600
PIPELINE_WORKER_PER_ACCOUNT_LIMIT=2
PIPELINE_CLASSIFIER_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=<your-openai-key>
OPENAI_AGENT_MODEL=gpt-5.6-luna
OPENAI_CRM_ANALYSIS_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VISION_MODEL=gpt-4.1-mini
ELEVENLABS_TTS_ENABLED=false
ELEVENLABS_API_KEY=<your-elevenlabs-key>
# Deixe vazio: a voz deve ser salva no binding do agente, nunca como padrao global.
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
TOOL_MEDIA_ALLOWED_HOSTS=
VISAGISM_TOOL_ENABLED=false
VISAGISM_INTERNAL_RUNTIME_ENABLED=true
VISAGISM_ANALYSIS_WORKER_MODEL=gemini-3.1-flash-lite
VISAGISM_MATCHING_WORKER_MODEL=gemini-3.1-flash-lite
VISAGISM_IMAGE_WORKER_MODEL=gpt-image-1
PRESCRIPTION_WORKER_ENABLED=true
PRESCRIPTION_WORKER_MODEL=gemini-3.1-flash-lite
GOOGLE_MAPS_API_KEY=
STORE_LOCATOR_ENABLED=false
STORE_LOCATOR_ROUTE_CACHE_MINUTES=30
REDIS_URL=redis://localhost:6379
EVOLUTION_API_URL=https://evo.example.com
EVOLUTION_API_KEY=<your-evolution-key>
EVOLUTION_WEBHOOK_SECRET=<shared-webhook-secret>
WEBHOOK_PUBLIC_BASE_URL=https://your-crm-backend.example.com
# Filtro opcional por instancia para testes pontuais
INSTANCE_PHONE_ALLOWLISTS_JSON={"mamis":["554199031152"]}

## Meta WhatsApp API (mock by default; no real WABA required locally)
META_PROVIDER_MODE=mock
META_GRAPH_API_VERSION=v20.0
META_APP_ID=<meta-app-id>
META_WEBHOOK_VERIFY_TOKEN=local-dev-verify-token
META_WEBHOOK_APP_SECRET=local-dev-app-secret
META_DEFAULT_LANGUAGE=pt_BR
META_TEMPLATES_FIXTURE_PATH=Project/IA/fixtures/meta/templates-list.json
META_WHATSAPP_ONBOARDING_MODE=internal_bootstrap
META_WHATSAPP_OUTBOUND_ENABLED=false
META_WHATSAPP_WEBHOOK_WORKER_ENABLED=false
META_WHATSAPP_TEMPLATE_SYNC_ENABLED=false
META_WHATSAPP_AUTOMATION_ENABLED=false

# Operacao backend-only; referencias apontam para secrets do ambiente.
META_BOOTSTRAP_ACES_ID=<tenant-id>
META_BOOTSTRAP_INSTANCE_NAME=<instance-name>
META_BOOTSTRAP_WABA_ID=<waba-id>
META_BOOTSTRAP_PHONE_NUMBER_ID=<phone-number-id>
META_BOOTSTRAP_BUSINESS_ID=<business-id>
META_BOOTSTRAP_ACCESS_TOKEN_SECRET_REF=META_PILOT_ACCESS_TOKEN
META_BOOTSTRAP_APP_SECRET_REF=META_APP_SECRET
META_BOOTSTRAP_VERIFY_TOKEN_SECRET_REF=META_WEBHOOK_VERIFY_TOKEN
META_BOOTSTRAP_ACTOR_ID=<operator-id>
META_PILOT_ACCESS_TOKEN=<backend-secret>
META_APP_SECRET=<backend-secret>

## Gupshup (appId, appName, API key e telefone sao salvos por canal via Admin API)
GUPSHUP_WEBHOOK_SECRET=<shared-webhook-secret>
# Apenas para teste local da selecao de variaveis; nao habilitar em producao.
# GUPSHUP_TEMPLATE_TEST_MODE=false

## Cobranca independente (somente backend; nunca expor no frontend)
COLLECTION_SECRETS_ENCRYPTION_KEY=<base64url-32-byte-key>
COLLECTION_SECRETS_ENCRYPTION_KEY_VERSION=v1
RB_WEBHOOK_JWT_SECRET=<long-random-shared-secret>
RB_API_BASE_URL=https://app.registrobase.com.br:32077

## Instagram Messaging (Meta App unico confirmado para o projeto)
INSTAGRAM_APP_ID=1096313326150839
INSTAGRAM_APP_SECRET=<instagram-app-secret>
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=<instagram-webhook-verify-token>
# Obrigatoria e validada na documentacao Meta antes do piloto; sem fallback no codigo.
INSTAGRAM_GRAPH_API_VERSION=<supported-version>
# AES-256-GCM: 32 bytes aleatorios em base64, mantidos apenas no backend.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=<base64-32-byte-key>
INSTAGRAM_TOKEN_ENCRYPTION_KEY_VERSION=v1
INSTAGRAM_CHANNEL_ENABLED=false
INSTAGRAM_OUTBOUND_ENABLED=false
INSTAGRAM_WEBHOOK_WORKER_ENABLED=false
INSTAGRAM_TOKEN_REFRESH_WORKER_ENABLED=false
INSTAGRAM_AUTOMATION_ENABLED=false
INSTAGRAM_PRODUCTION_ROLLOUT_AUTHORIZED=false
INSTAGRAM_CONVERSATION_WINDOW_HOURS=24
INSTAGRAM_WEBHOOK_WORKER_POLL_MS=1000
INSTAGRAM_WEBHOOK_WORKER_BATCH_SIZE=10
INSTAGRAM_TOKEN_REFRESH_WORKER_POLL_MS=60000
INSTAGRAM_TOKEN_REFRESH_WORKER_BATCH_SIZE=5
# URLs publicas; nenhum segredo e enviado ao frontend.
CRM_BACKEND_PUBLIC_URL=https://your-crm-backend.example.com
CRM_FRONTEND_PUBLIC_URL=https://your-crm.example.com

## Agenda Universal (somente backend; AES-256-GCM, 32 bytes em base64url ou 64 hex)
AGENDA_SECRETS_ENCRYPTION_KEY=<base64url-32-byte-key>
AGENDA_SECRETS_ENCRYPTION_KEY_VERSION=v1
AGENDA_WORKER_POLL_MS=2000
AGENDA_WORKER_BATCH_SIZE=20
AGENDA_WORKER_LEASE_SECONDS=60
AGENDA_WORKER_HTTP_TIMEOUT_MS=10000
AGENDA_WORKER_MAX_RESPONSE_BYTES=65536
AGENDA_RESYNC_WORKER_POLL_MS=2000
AGENDA_RESYNC_WORKER_BATCH_SIZE=100
AGENDA_RESYNC_WORKER_LEASE_SECONDS=60
AGENDA_INBOUND_RATE_LIMIT_PER_MINUTE=120

## Cloudflare Tunnel local nomeado: instagram-local
# Public hostname: instagram-dev-api.itstime.pro -> http://backend:3000
# O token fica isolado em .env.cloudflare; use .env.cloudflare.example.

PORT=3000
NODE_ENV=development
AUTOMATION_WORKER_ENABLED=true
AUTOMATION_WORKER_POLL_MS=300000
AUTOMATION_WORKER_BATCH_SIZE=50
RB_BILLING_WORKER_ENABLED=false
RB_BILLING_WORKER_POLL_MS=60000
BI_PROJECTION_WORKER_ENABLED=false
BI_PROJECTION_BATCH_SIZE=100
CALENDAR_FOLLOWUP_ENABLED=false
CALENDAR_FOLLOWUP_DRY_RUN=true
CALENDAR_FOLLOWUP_BATCH_SIZE=25
CALENDAR_FOLLOWUP_1H_TEMPLATE=Ola, {nome}! Passando para lembrar do compromisso "{titulo}" hoje as {horario}.
# ID do template aprovado. Parametros enviados: nome, titulo, data e horario.
CALENDAR_FOLLOWUP_HSM_TEMPLATE_ID=
CALENDAR_FOLLOWUP_HSM_LANGUAGE=pt_BR
AGENT_FOLLOWUP_ENABLED=false
AGENT_FOLLOWUP_DRY_RUN=true
AGENT_FOLLOWUP_BATCH_SIZE=25
AGENT_FOLLOWUP_META_TEMPLATE_NAME=
AGENT_FOLLOWUP_META_TEMPLATE_LANGUAGE=pt_BR
UNANSWERED_FOLLOWUP_ENABLED=false
UNANSWERED_FOLLOWUP_DRY_RUN=true
UNANSWERED_FOLLOWUP_BATCH_SIZE=25


## SMTP do Supabase self-hosted (valor real somente no .env protegido da VPS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=matheus@itstime.pro
SMTP_PASS=<rotate-and-store-only-in-secret-env>
SMTP_SENDER_NAME=Its Time
