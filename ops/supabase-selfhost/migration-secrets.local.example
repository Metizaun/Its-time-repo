# Copy to migration-secrets.local. The *.local file is ignored by Git.
# Never commit or paste the real values into chat.

# Managed Supabase database password used only to produce the migration dump.
SUPABASE_DB_PASSWORD=

# Optional only if Storage is moved to Cloudflare R2 in the future.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# New Hostinger SMTP password after rotation.
SMTP_PASSWORD=

# Temporary S3 credentials from the managed Supabase project for rclone.
PLATFORM_S3_ACCESS_KEY_ID=
PLATFORM_S3_SECRET_ACCESS_KEY=
PLATFORM_S3_ENDPOINT=

# Optional: enables non-interactive Vercel env updates and deployment.
VERCEL_TOKEN=

# Optional: enables Cloudflare automation. Required scopes for this cut:
# Account / Access: Apps and Policies / Edit
# Zone / Zone / Read
# Zone / DNS / Edit
# Zone / Config Rules / Edit (for per-host Full strict without changing the whole zone)
CLOUDFLARE_API_TOKEN=
